{
  "name": "world-flip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "World Flip: a side-scrolling browser platformer where the world's rules flip every 50 seconds.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tiles": "node scripts/make-placeholder-tiles.mjs",
    "gen:level": "node scripts/make-test-level.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
